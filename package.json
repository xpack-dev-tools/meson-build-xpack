      "meson-python3": "./.content/bin/meson-python3"
    }
  },
  "devDependencies": {
    "del-cli": "^6.0.0",
    "json": "^11.0.0",
    "liquidjs": "^10.19.1"
  },
  "topConfig": {
    "longName": "Meson Build",
    "shortName": "meson-build"
  },
  "engines": {
    "node": " >=18.0.0"
  }
